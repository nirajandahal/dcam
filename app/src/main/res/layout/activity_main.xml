<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== Top bar ===== -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/gridBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="@drawable/bg_round_button"
                android:src="@drawable/ic_grid"
                android:scaleType="fitCenter"
                android:contentDescription="Grid" />

            <ImageButton
                android:id="@+id/flashBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="9dp"
                android:background="@drawable/bg_round_button"
                android:src="@drawable/ic_flash_off"
                android:scaleType="fitCenter"
                android:contentDescription="Torch" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/formatGroup"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill"
                android:padding="3dp">

                <TextView
                    android:id="@+id/fmtVertical"
                    style="@style/SegmentChip"
                    android:text="9:16" />

                <TextView
                    android:id="@+id/fmtBoth"
                    style="@style/SegmentChip"
                    android:text="Both" />

                <TextView
                    android:id="@+id/fmtHorizontal"
                    style="@style/SegmentChip"
                    android:text="16:9" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="@drawable/bg_round_button"
                android:src="@drawable/ic_settings"
                android:scaleType="fitCenter"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- ===== Viewfinder ===== -->
        <FrameLayout
            android:id="@+id/viewfinder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.dualview.camera.AspectFrameLayout
                android:id="@+id/previewFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <SurfaceView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.dualview.camera.OverlayView
                    android:id="@+id/overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.dualview.camera.AspectFrameLayout>
        </FrameLayout>

        <!-- ===== Recording badge ===== -->
        <LinearLayout
            android:id="@+id/recBadge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rec_badge"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/recDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_white" />

            <TextView
                android:id="@+id/recTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ===== Bottom controls ===== -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:gravity="center"
                android:text="" />

            <LinearLayout
                android:id="@+id/zoomGroup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill"
                android:padding="3dp"
                android:layout_marginBottom="10dp">

                <TextView android:id="@+id/zoom1" style="@style/ZoomChip" android:text="1x" />
                <TextView android:id="@+id/zoom2" style="@style/ZoomChip" android:text="2x" />
                <TextView android:id="@+id/zoom3" style="@style/ZoomChip" android:text="3x" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeGroup"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView android:id="@+id/modePhoto" style="@style/ModeChip" android:text="Photo" />
                <TextView android:id="@+id/modeVideo" style="@style/ModeChip" android:text="Video" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="76dp">

                <ImageButton
                    android:id="@+id/galleryBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="28dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_round_button"
                    android:src="@drawable/ic_photos"
                    android:scaleType="fitCenter"
                    android:contentDescription="Open gallery" />

                <ImageButton
                    android:id="@+id/pauseBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="28dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_round_button"
                    android:src="@drawable/ic_pause"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Pause" />

                <Button
                    android:id="@+id/shutterBtn"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_photo"
                    android:contentDescription="Shutter" />

                <ImageButton
                    android:id="@+id/flipBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="28dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_round_button"
                    android:src="@drawable/ic_flip"
                    android:scaleType="fitCenter"
                    android:contentDescription="Switch camera" />

                <ImageButton
                    android:id="@+id/stillBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="28dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_round_button"
                    android:src="@drawable/ic_still"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Take photo while recording" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Countdown ===== -->
        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="76sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/viewfinder"
            app:layout_constraintBottom_toBottomOf="@id/viewfinder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Settings sheet ===== -->
    <include layout="@layout/panel_settings" />

</FrameLayout>
